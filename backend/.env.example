# Copy this file to ".env" (same folder) and fill in the values.
# The demo accounts work even if everything below is empty.

PORT=4000

# Long random string. REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# One-click demo logins. Set to false before a real deployment.
ENABLE_DEMO=true

# --- MongoDB Atlas (optional locally: empty = in-memory store that resets on restart) ---
MONGODB_URI=
MONGODB_DB=saathi

# --- Firebase Auth (server side) ---
FIREBASE_PROJECT_ID=
# Path to the service-account key file (relative to this backend folder) OR the raw JSON text.
FIREBASE_SERVICE_ACCOUNT_JSON=service_account.json

# Emails that become ADMIN the first time they sign in (comma separated).
ADMIN_EMAILS=
# false = a new pharmacist/health-worker account waits until an admin approves it.
AUTO_APPROVE_STAFF=false

# Allowed browser origins when the frontend calls the API directly (comma separated).
CORS_ORIGIN=http://localhost:3000
