# Copy to .env.local and fill in. Demo accounts work even if everything below is empty.

# --- Session (REQUIRED in production; use a long random string) ---
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Demo accounts: one-click login, no password, no Firebase needed ---
# Set to "false" before a real deployment.
ENABLE_DEMO=true

# --- MongoDB (optional locally: without it the app uses an in-memory store) ---
MONGODB_URI=
MONGODB_DB=saathi

# --- Firebase client (Project settings > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-side token check) ---
# Paste the service-account JSON on one line. If empty, only the project ID is used
# to verify ID tokens, which is enough for email/password sign-in.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Public URL used inside QR codes (defaults to the current origin) ---
NEXT_PUBLIC_APP_URL=
