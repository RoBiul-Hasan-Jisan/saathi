# Copy this file to ".env.local" (same folder) and fill in the values.

# Where the backend runs. The frontend forwards /api/* to it.
BACKEND_URL=http://localhost:4000

# --- Firebase web app config (Firebase console > Project settings > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public address of this site, used inside QR codes. Leave empty locally (uses the current address).
NEXT_PUBLIC_APP_URL=
